// everyware_ui: UI components (button, icon button, toggle, radio, dropdown, list item,
// keyboard) for harry apps. components.json is the shared spec with the Figma generator.

package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

rust_defaults {
    name: "everyware_ui_core_defaults",
    crate_name: "everyware_ui_core",
    crate_root: "core/src/lib.rs",
    // With crate_root, srcs lists every file of the compilation: transitions.rs reads
    // components.json with include_str!.
    srcs: [
        "core/src/*.rs",
        "components.json",
    ],
    rustlibs: [
        "libserde",
        "libserde_json",
    ],
    host_supported: true,
    vendor_available: true,
    // in the panel's APEX (com.everyware.smarthome, min_sdk 35)
    min_sdk_version: "29",
}

// The logic, without harry: host and device, tested on the host.
rust_library {
    name: "libeveryware_ui_core",
    defaults: ["everyware_ui_core_defaults"],
    visibility: ["//visibility:public"],
}

rust_test_host {
    name: "everyware_ui_core_test",
    defaults: ["everyware_ui_core_defaults"],
    test_suites: ["general-tests"],
}

// The harry binding. harry's framework crates are visible to //vendor.
rust_library {
    name: "libeveryware_ui",
    crate_name: "everyware_ui",
    crate_root: "harry/src/lib.rs",
    srcs: ["harry/src/*.rs"],
    rustlibs: [
        "libcustomizations",
        "libhar_platform_api",
        "libharry_animation",
        // pictures of components (src/images.rs): raw image storage, decoding
        "libhar_types",
        "libimage",
        // the design's sizes from the .dcf (src/design.rs)
        "libdc_bundle",
        "libeveryware_ui_core",
        // a list whose slot takes no taps, said once (Input)
        "liblog_rust",
    ],
    // ui_model! (src/model.rs): its derives, re-exported for the apps' call sites
    proc_macros: [
        "libderive_customizations",
        "libhar_ui_model_derive",
    ],
    // the host too: the recipes test (everyware_ui_recipes_test) links the library as an app does
    host_supported: true,
    vendor_available: true,
    // in the panel's APEX (com.everyware.smarthome, min_sdk 35)
    min_sdk_version: "29",
    visibility: ["//visibility:public"],
}

// Host tests of the harry binding: slots (SlotCustomizer, caret blink, tap names) and the
// contract with the Figma library: every part the code sets is in every variant of its set,
// checked against the .dcf the app ships.
rust_test_host {
    name: "everyware_ui_test",
    crate_name: "everyware_ui",
    crate_root: "harry/src/lib.rs",
    srcs: ["harry/src/*.rs"],
    rustlibs: [
        "libcustomizations",
        "libdc_bundle",
        "libhar_platform_api",
        "libharry_animation",
        // pictures of components (src/images.rs): raw image storage, decoding
        "libhar_types",
        "libimage",
        "libeveryware_ui_core",
        "liblog_rust",
    ],
    proc_macros: [
        "libderive_customizations",
        "libhar_ui_model_derive",
    ],
    data: ["data/library.dcf"],
    test_suites: ["general-tests"],
}

// The examples the docs show (docs/examples/<component>.rs, one small app per component):
// compiled and tapped, so an example that does not build fails here and not in an app.
rust_test_host {
    name: "everyware_ui_recipes_test",
    crate_name: "everyware_ui_recipes",
    // the examples of the guides (docs/content/<component>.md), one module per component
    crate_root: "docs/examples/lib.rs",
    srcs: ["docs/examples/*.rs"],
    rustlibs: [
        "libcustomizations",
        "libeveryware_ui",
        "libhar_platform_api",
        "libharry",
        "liblog_rust",
    ],
    proc_macros: [
        "libderive_customizations",
        "libhar_ui_model_derive",
    ],
    test_suites: ["general-tests"],
}
