#!/bin/bash
# A merge into main is made by everyware's scripts/feature.sh land, after the branch's review and
# the user's word (AGENTS.md of everyware, "How a change lands"); not by a bare git merge. This
# hook refuses a merge commit early; reference-transaction holds main against every other way.
branch=$(git symbolic-ref --short -q HEAD || true)
if [ "$branch" = main ] && [ "${EVERYWARE_LAND:-}" != 1 ]; then
    echo "pre-merge-commit: main gets a branch through vendor/sdv-everyware/everyware/scripts/feature.sh land <name> \"<summary>\"; undo this one with git merge --abort" >&2
    exit 1
fi
